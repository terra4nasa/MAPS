<div class="flex flex-col h-screen bg-slate-950 text-slate-100 font-sans">
  <!-- Top Navigation -->
  <header class="flex items-center justify-between px-6 py-3 bg-slate-900 border-b border-cyan-800">
    <div class="flex items-center gap-3">
      <span class="p-2 bg-cyan-600 rounded-lg font-bold text-xs tracking-widest text-slate-950">NASA DATA</span>
      <h1 class="text-xl font-bold tracking-wider text-cyan-400">MARSWALK // SURVIVAL COPILOT</h1>
    </div>
    <div class="flex items-center gap-6 text-sm font-mono">
      <span>SECTOR: <strong class="text-amber-400">Jezero Crater</strong></span>
      <span>EVA ELAPSED: <strong class="text-cyan-400">03:42:10</strong></span>
      <span class="px-2 py-1 bg-emerald-950 text-emerald-400 border border-emerald-600 rounded">COMM: ONLINE</span>
    </div>
  </header>

  <!-- Main Viewport -->
  <div class="flex flex-1 overflow-hidden">
    <!-- Left Panel: Layers & Controls -->
    <aside class="w-72 bg-slate-900/80 p-4 border-r border-slate-800 flex flex-col justify-between">
      <div class="space-y-6">
        <div>
          <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-400 mb-3">Map Layers</h2>
          <div class="space-y-2 text-sm">
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="checkbox" checked class="accent-cyan-500"> HiRISE Optical Imagery
            </label>
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="checkbox" checked class="accent-cyan-500"> Elevation & Slope Gradient
            </label>
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="checkbox" class="accent-cyan-500"> Subsurface Water Ice (ISRU)
            </label>
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="checkbox" checked class="accent-cyan-500"> Solar Radiation Heatmap
            </label>
          </div>
        </div>
        <div>
          <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-400 mb-3">Path Optimization</h2>
          <button class="w-full py-2 bg-cyan-600 hover:bg-cyan-500 text-slate-950 font-bold rounded shadow transition">
            Compute Optimal Route
          </button>
        </div>
      </div>
      <button class="w-full py-2 border border-red-600 text-red-400 hover:bg-red-950/50 rounded font-semibold text-xs uppercase tracking-wider">
        Simulate Dust Storm Hazard
      </button>
    </aside>

    <!-- Center Canvas (Map Target) -->
    <main class="flex-1 relative bg-slate-900 flex items-center justify-center">
      <div class="absolute inset-0 bg-[radial-gradient(#1e293b_1px,transparent_1px)] [background-size:16px_16px] opacity-40"></div>
      <div class="text-center space-y-2 z-10">
        <p class="text-slate-500 font-mono text-sm">[ Interactive Map Canvas Container ]</p>
        <p class="text-xs text-cyan-500/70 font-mono">Render Leaflet.js / Mapbox GL JS / Three.js 3D Globe Here</p>
      </div>
      <!-- Floating Route Summary Card -->
      <div class="absolute bottom-6 left-6 bg-slate-900/90 border border-slate-700 p-4 rounded-lg shadow-xl text-xs font-mono space-y-1">
        <p class="text-cyan-400 font-bold">ACTIVE ROUTE: WAYPOINT A -> B BASE</p>
        <p class="text-slate-300">Total Distance: 4.2 km | Estimated Slope Risk: <span class="text-emerald-400">LOW</span></p>
      </div>
    </main>

    <!-- Right Panel: Telemetry & Alerts -->
    <aside class="w-80 bg-slate-900/80 p-4 border-l border-slate-800 space-y-6">
      <div>
        <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-400 mb-3">Suit Telemetry</h2>
        <div class="space-y-3 font-mono text-xs">
          <div>
            <div class="flex justify-between mb-1">
              <span>Oxygen Reserve</span>
              <span class="text-cyan-400">84%</span>
            </div>
            <div class="w-full bg-slate-800 h-2 rounded-full overflow-hidden">
              <div class="bg-cyan-500 h-full w-[84%]"></div>
            </div>
          </div>
          <div>
            <div class="flex justify-between mb-1">
              <span>Power Cell</span>
              <span class="text-amber-400">62%</span>
            </div>
            <div class="w-full bg-slate-800 h-2 rounded-full overflow-hidden">
              <div class="bg-amber-500 h-full w-[62%]"></div>
            </div>
          </div>
        </div>
      </div>

      <div>
        <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-400 mb-3">Environmental Alerts</h2>
        <div class="p-3 bg-red-950/40 border border-red-800/80 rounded text-xs space-y-1">
          <div class="flex items-center gap-2 text-red-400 font-bold">
            <span class="h-2 w-2 rounded-full bg-red-500 animate-pulse"></span>
            HIGH WIND WARNING
          </div>
          <p class="text-slate-400">Approaching dust front detected 12km NW. Estimated impact in T-45 mins.</p>
        </div>
      </div>
    </aside>
  </div>
</div>
